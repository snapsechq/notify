<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Asset Staged for Decommission - SnapSec</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            margin: 0;
            padding: 0;
            width: 100% !important;
            -webkit-text-size-adjust: 100%;
            -ms-text-size-adjust: 100%;
        }

        table {
            border-spacing: 0;
            border-collapse: collapse;
            mso-table-lspace: 0pt;
            mso-table-rspace: 0pt;
        }

        td {
            padding: 0;
        }

        img {
            border: 0;
            line-height: 100%;
            outline: none;
            text-decoration: none;
            -ms-interpolation-mode: bicubic;
        }

        @media screen and (max-width: 520px) {
            .mobile-padding {
                padding-left: 20px !important;
                padding-right: 20px !important;
            }

            .mobile-width {
                width: 100% !important;
                max-width: 100% !important;
            }

            .stack-column {
                display: block !important;
                width: 100% !important;
                padding: 8px 0 !important;
            }
        }
    </style>
</head>

<body
    style="margin: 0; padding: 0; background-color: #f3f4f6; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">

    <!-- Wrapper Table -->
    <table width="100%" border="0" cellspacing="0" cellpadding="0" style="background-color: #f3f4f6; width: 100%;">
        <tr>
            <td align="center" style="padding: 48px 16px;">

                <!-- Main Email Card -->
                <table width="100%" border="0" cellspacing="0" cellpadding="0" class="mobile-width"
                    style="max-width: 520px; width: 100%; background-color: #ffffff; border-radius: 24px; border: 1px solid #e5e7eb; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.05); border-collapse: separate;">

                    <!-- Top Accent Bar (Amber for Staged / Approval Needed) -->
                    <tr>
                        <td height="6"
                            style="background-color: #f59e0b; line-height: 6px; font-size: 6px; border-radius: 24px 24px 0 0;">
                            &nbsp;</td>
                    </tr>

                    <!-- Header Section -->
                    <tr>
                        <td align="center" style="padding: 44px 40px 24px 40px;" class="mobile-padding">
                            <!-- Logo Box -->
                            <table border="0" cellspacing="0" cellpadding="0">
                                <tr>
                                    <td align="center" valign="middle" width="64" height="64"
                                        style="background-color: #fffbeb; border-radius: 16px; border: 1px solid #fef3c7;">
                                        <img src="{{logo_url}}" width="40"
                                            alt="SnapSec Logo" style="display: block; border: 0;">
                                    </td>
                                </tr>
                            </table>

                            <h1
                                style="color: #111827; font-size: 22px; font-weight: 700; margin: 20px 0 0 0; letter-spacing: -0.02em; line-height: 1.2;">
                                Asset Staged for Decommission
                            </h1>
                            <p style="color: #4b5563; font-size: 14px; margin: 8px 0 0 0; line-height: 1.5;">
                                An asset has been staged for decommission and requires your approval.
                            </p>
                        </td>
                    </tr>

                    <!-- Details Section -->
                    <tr>
                        <td style="padding: 0 40px 32px 40px;" class="mobile-padding">
                            <table width="100%" border="0" cellspacing="0" cellpadding="0">

                                <!-- Asset Value & Type Header -->
                                <tr>
                                    <td style="padding-bottom: 20px;">
                                        <p
                                            style="color: #64748b; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 6px 0;">
                                            Asset</p>
                                        <p
                                            style="color: #111827; font-size: 18px; font-weight: 700; margin: 0; line-height: 1.3; word-break: break-all;">
                                            {{asset_value}}</p>
                                    </td>
                                </tr>

                                <!-- Status & Metadata Card -->
                                <tr>
                                    <td style="padding-bottom: 20px;">
                                        <table width="100%" border="0" cellspacing="0" cellpadding="0"
                                            style="background-color: #f8fafc; border-radius: 12px; border: 1px solid #e2e8f0; padding: 16px;">
                                            <tr>
                                                <td class="stack-column" width="50%" style="vertical-align: top; padding-bottom: 12px;">
                                                    <p style="color: #64748b; font-size: 11px; font-weight: 600; text-transform: uppercase; margin: 0 0 4px 0;">
                                                        Asset Type</p>
                                                    <p style="color: #0f172a; font-size: 14px; font-weight: 600; margin: 0; text-transform: capitalize;">
                                                        {{asset_type}}</p>
                                                </td>
                                                <td class="stack-column" width="50%" style="vertical-align: top; padding-bottom: 12px;">
                                                    <p style="color: #64748b; font-size: 11px; font-weight: 600; text-transform: uppercase; margin: 0 0 4px 0;">
                                                        Current Status</p>
                                                    <span style="display: inline-block; background-color: #fef3c7; color: #92400e; font-size: 12px; font-weight: 600; padding: 2px 8px; border-radius: 6px;">
                                                        Staged (Pending Approval)
                                                    </span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="stack-column" width="50%" style="vertical-align: top;">
                                                    <p style="color: #64748b; font-size: 11px; font-weight: 600; text-transform: uppercase; margin: 0 0 4px 0;">
                                                        Staged By</p>
                                                    <p style="color: #0f172a; font-size: 13px; font-weight: 600; margin: 0;">
                                                        {{staged_by}}</p>
                                                    {{#if staged_by_email}}
                                                    <p style="color: #64748b; font-size: 12px; margin: 2px 0 0 0;">
                                                        {{staged_by_email}}</p>
                                                    {{/if}}
                                                </td>
                                                <td class="stack-column" width="50%" style="vertical-align: top;">
                                                    <p style="color: #64748b; font-size: 11px; font-weight: 600; text-transform: uppercase; margin: 0 0 4px 0;">
                                                        Date Staged</p>
                                                    <p style="color: #0f172a; font-size: 13px; font-weight: 600; margin: 0;">
                                                        {{staged_at}}</p>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <!-- Decommission Reason -->
                                {{#if reason}}
                                <tr>
                                    <td style="padding-bottom: 24px;">
                                        <table width="100%" border="0" cellspacing="0" cellpadding="0"
                                            style="background-color: #fffbeb; border-radius: 12px; border: 1px solid #fef3c7; padding: 14px 16px;">
                                            <tr>
                                                <td>
                                                    <p style="color: #92400e; font-size: 11px; font-weight: 600; text-transform: uppercase; margin: 0 0 4px 0;">
                                                        Reason for Decommission</p>
                                                    <p style="color: #78350f; font-size: 13px; margin: 0; line-height: 1.5;">
                                                        {{reason}}</p>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                                {{/if}}

                                <!-- Call to Action Button -->
                                <tr>
                                    <td align="center" style="padding-bottom: 20px;">
                                        <table border="0" cellspacing="0" cellpadding="0" width="100%">
                                            <tr>
                                                <td align="center">
                                                    <a href="{{action_url}}" target="_blank"
                                                        style="display: block; width: 100%; box-sizing: border-box; background-color: #0f172a; color: #ffffff; text-align: center; padding: 14px 24px; font-size: 14px; font-weight: 600; border-radius: 12px; text-decoration: none; letter-spacing: -0.01em;">
                                                        Review & Approve Asset
                                                    </a>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <!-- Fallback link -->
                                <tr>
                                    <td align="center">
                                        <p style="color: #9ca3af; font-size: 12px; margin: 0; line-height: 1.5;">
                                            Or copy and paste this link in your browser:<br>
                                            <a href="{{action_url}}" style="color: #4f46e5; text-decoration: underline; word-break: break-all;">{{action_url}}</a>
                                        </p>
                                    </td>
                                </tr>

                            </table>
                        </td>
                    </tr>

                    <!-- Footer Section -->
                    <tr>
                        <td style="background-color: #f9fafb; border-top: 1px solid #f3f4f6; padding: 24px 40px; text-align: center;"
                            class="mobile-padding">
                            <p style="color: #9ca3af; font-size: 12px; margin: 0; line-height: 1.5;">
                                This is an automated notification from <strong>SnapSec Suite</strong>.<br>
                                You are receiving this because you are configured as an authorized approver for asset decommissioning.
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>

</html>
