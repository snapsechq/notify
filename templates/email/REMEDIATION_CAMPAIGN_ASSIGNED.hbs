<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Remediation Campaign Assigned - SnapSec</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        /* Base styles for email clients */
        body {
            margin: 0;
            padding: 0;
            width: 100% !important;
            -webkit-text-size-adjust: 100%;
            -ms-text-size-adjust: 100%;
        }

        table {
            border-spacing: 0;
            border-collapse: collapse;
            mso-table-lspace: 0pt;
            mso-table-rspace: 0pt;
        }

        td {
            padding: 0;
        }

        img {
            border: 0;
            line-height: 100%;
            outline: none;
            text-decoration: none;
            -ms-interpolation-mode: bicubic;
        }

        /* Mobile specific styles */
        @media screen and (max-width: 520px) {
            .mobile-padding {
                padding-left: 20px !important;
                padding-right: 20px !important;
            }

            .mobile-width {
                width: 100% !important;
                max-width: 100% !important;
            }

            .stack-column {
                display: block !important;
                width: 100% !important;
                padding: 10px 0 !important;
            }
        }
    </style>
</head>

<body
    style="margin: 0; padding: 0; background-color: #f3f4f6; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">

    <!-- Wrapper Table -->
    <table width="100%" border="0" cellspacing="0" cellpadding="0" style="background-color: #f3f4f6; width: 100%;">
        <tr>
            <td align="center" style="padding: 48px 16px;">

                <!-- Main Email Card -->
                <table width="100%" border="0" cellspacing="0" cellpadding="0" class="mobile-width"
                    style="max-width: 520px; width: 100%; background-color: #ffffff; border-radius: 24px; border: 1px solid #e5e7eb; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.05); border-collapse: separate;">

                    <!-- Top Accent Bar -->
                    <tr>
                        <td height="6"
                            style="background-color: #1379f0; line-height: 6px; font-size: 6px; border-radius: 24px 24px 0 0;">
                            &nbsp;</td>
                    </tr>

                    <!-- Header Section -->
                    <tr>
                        <td align="center" style="padding: 44px 40px 28px 40px;" class="mobile-padding">
                            <!-- Logo Box -->
                            <table border="0" cellspacing="0" cellpadding="0">
                                <tr>
                                    <td align="center" valign="middle" width="64" height="64"
                                        style="background-color: #f0f7ff; border-radius: 16px;">
                                        <img src="{{logo_url}}" width="40"
                                            alt="SnapSec Logo" style="display: block; border: 0;">
                                    </td>
                                </tr>
                            </table>

                            <h1
                                style="color: #111827; font-size: 22px; font-weight: 700; margin: 20px 0 0 0; letter-spacing: -0.02em; line-height: 1.2;">
                                Remediation Campaign Assigned
                            </h1>
                            <p style="color: #4b5563; font-size: 14px; margin: 8px 0 0 0; line-height: 1.5;">
                                A remediation campaign has been assigned to you for resolution.
                            </p>
                        </td>
                    </tr>

                    <!-- Details Section -->
                    <tr>
                        <td style="padding: 0 40px 36px 40px;" class="mobile-padding">
                            <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                <tr>
                                    <td style="padding-bottom: 20px;">
                                        <p
                                            style="color: #64748b; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 6px 0;">
                                            Campaign</p>
                                        <p
                                            style="color: #111827; font-size: 18px; font-weight: 700; margin: 0; line-height: 1.3;">
                                            {{campaign.name}}</p>
                                        {{#if campaign.description}}
                                        <p style="color: #64748b; font-size: 13px; margin: 6px 0 0 0; line-height: 1.5;">
                                            {{campaign.description}}
                                        </p>
                                        {{/if}}
                                    </td>
                                </tr>

                                <!-- Component & Action Card -->
                                <tr>
                                    <td style="padding-bottom: 20px;">
                                        <table width="100%" border="0" cellspacing="0" cellpadding="0"
                                            style="background-color: #f8fafc; border-radius: 12px; border: 1px solid #e2e8f0; padding: 14px 16px;">
                                            <tr>
                                                <td class="stack-column" width="50%" style="vertical-align: top;">
                                                    <p style="color: #64748b; font-size: 11px; font-weight: 600; text-transform: uppercase; margin: 0 0 4px 0;">
                                                        Component</p>
                                                    <p style="color: #0f172a; font-size: 14px; font-weight: 600; margin: 0;">
                                                        {{campaign.package}}</p>
                                                </td>
                                                <td class="stack-column" width="50%" style="vertical-align: top;">
                                                    <p style="color: #64748b; font-size: 11px; font-weight: 600; text-transform: uppercase; margin: 0 0 4px 0;">
                                                        Remediation</p>
                                                    <p style="color: #0f172a; font-size: 14px; font-weight: 600; margin: 0; text-transform: capitalize;">
                                                        {{campaign.remediationType}}</p>
                                                </td>
                                            </tr>
                                            {{#if campaign.action}}
                                            <tr>
                                                <td colspan="2" style="padding-top: 12px; border-top: 1px dashed #cbd5e1; margin-top: 10px;">
                                                    <p style="color: #64748b; font-size: 11px; font-weight: 600; text-transform: uppercase; margin: 0 0 4px 0;">
                                                        Recommended Action</p>
                                                    <p style="color: #0f172a; font-size: 13px; font-weight: 500; margin: 0;">
                                                        {{campaign.action}}</p>
                                                </td>
                                            </tr>
                                            {{/if}}
                                        </table>
                                    </td>
                                </tr>

                                <!-- Metrics Grid -->
                                <tr>
                                    <td style="padding-bottom: 24px;">
                                        <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                            <tr>
                                                <td width="32%" align="center"
                                                    style="background-color: #ffffff; border: 1px dashed #cbd5e1; border-radius: 10px; padding: 12px 8px;">
                                                    <p style="color: #0f172a; font-size: 20px; font-weight: 700; margin: 0; line-height: 1;">
                                                        {{campaign.assetCount}}</p>
                                                    <p style="color: #64748b; font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin: 6px 0 0 0;">
                                                        Assets</p>
                                                </td>
                                                <td width="2%">&nbsp;</td>
                                                <td width="32%" align="center"
                                                    style="background-color: #ffffff; border: 1px dashed #cbd5e1; border-radius: 10px; padding: 12px 8px;">
                                                    <p style="color: #ef4444; font-size: 20px; font-weight: 700; margin: 0; line-height: 1;">
                                                        {{campaign.openVulnCount}}</p>
                                                    <p style="color: #64748b; font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin: 6px 0 0 0;">
                                                        Open Vulns</p>
                                                </td>
                                                <td width="2%">&nbsp;</td>
                                                <td width="32%" align="center"
                                                    style="background-color: #ffffff; border: 1px dashed #cbd5e1; border-radius: 10px; padding: 12px 8px;">
                                                    <p style="color: #10b981; font-size: 20px; font-weight: 700; margin: 0; line-height: 1;">
                                                        {{campaign.exposureScoreReduction}}</p>
                                                    <p style="color: #64748b; font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin: 6px 0 0 0;">
                                                        Score Reduction</p>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <!-- CTA Button -->
                                <tr>
                                    <td align="center" style="padding-bottom: 28px;">
                                        <!--[if mso]>
                                        <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{action_url}}" style="height:48px;v-text-anchor:middle;width:240px;" arcsize="25%" stroke="f" fillcolor="#1379f0">
                                          <w:anchorlock/>
                                          <center>
                                        <![endif]-->
                                        <a href="{{action_url}}"
                                            style="background-color: #1379f0; border-radius: 12px; color: #ffffff; display: inline-block; font-size: 15px; font-weight: 600; line-height: 48px; text-align: center; text-decoration: none; width: 100%; box-shadow: 0 4px 12px rgba(19, 121, 240, 0.25);">
                                            View Remediation Campaign
                                        </a>
                                        <!--[if mso]>
                                          </center>
                                        </v:roundrect>
                                        <![endif]-->
                                    </td>
                                </tr>

                                <!-- Message Divider -->
                                <tr>
                                    <td style="border-top: 1px solid #f1f5f9; padding-top: 24px;">
                                        <p style="color: #4b5563; font-size: 14px; line-height: 1.6; margin: 0;">
                                            Hello {{assignee.name}},<br><br>
                                            You have been assigned as the owner of this remediation campaign{{#if actorName}} by <strong>{{actorName}}</strong>{{/if}}. 
                                            Resolving this component fix will remediate <strong>{{campaign.openVulnCount}}</strong> vulnerabilities across <strong>{{campaign.assetCount}}</strong> affected assets.
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center"
                            style="padding: 36px 40px; background-color: #f9fafb; border-top: 1px solid #f3f4f6;"
                            class="mobile-padding">
                            <p
                                style="color: #64748b; font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.1em; margin: 0;">
                                &copy; {{year}} SnapSec Suite. All rights reserved.
                            </p>
                            <p style="color: #94a3b8; font-size: 12px; margin: 4px 0 0 0;">
                                Unified Cybersecurity Products & Solutions
                            </p>

                            <!-- Footer Links -->
                            <table border="0" cellspacing="0" cellpadding="0" style="margin-top: 20px;">
                                <tr>
                                    <td style="padding: 0 12px;">
                                        <a href="{{base_url}}"
                                            style="color: #1379f0; text-decoration: none; font-weight: 600; font-size: 13px;">Dashboard</a>
                                    </td>
                                    <td style="padding: 0 12px;">
                                        <a href="https://docs.snapsec.co/"
                                            style="color: #1379f0; text-decoration: none; font-weight: 600; font-size: 13px;">Help Center</a>
                                    </td>
                                    <td style="padding: 0 12px;">
                                        <a href="https://snapsec.co/privacy"
                                            style="color: #1379f0; text-decoration: none; font-weight: 600; font-size: 13px;">Privacy</a>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

                <!-- Bottom Meta Footer -->
                <table width="100%" border="0" cellspacing="0" cellpadding="0" class="mobile-width"
                    style="max-width: 520px; width: 100%; margin-top: 20px;">
                    <tr>
                        <td align="center" style="padding: 0 40px 40px 40px;" class="mobile-padding">
                            <p style="color: #94a3b8; font-size: 11px; line-height: 1.6; margin: 0;">
                                This is an automated security notification from SnapSec. You can manage your
                                notification preferences in your profile settings.
                            </p>
                        </td>
                    </tr>
                </table>

            </td>
        </tr>
    </table>
</body>

</html>
